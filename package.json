{
  "name": "prdashboards",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gen": "pnpm gen:go && pnpm gen:ts",
    "gen:go": "go -C server tool oapi-codegen -config ../api/oapi-codegen.yaml ../api/openapi.yaml",
    "gen:ts": "pnpm -C web gen",
    "start": "bash scripts/start.sh",
    "docs-check": "node scripts/check-docs.mjs",
    "version-check": "node scripts/check-version.mjs",
    "coverage-check": "bash scripts/check-coverage.sh",
    "test:scripts": "node --test \"scripts/*.test.mjs\""
  }
}
